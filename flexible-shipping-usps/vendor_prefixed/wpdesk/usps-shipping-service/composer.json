{
    "name": "wpdesk\/usps-shipping-service",
    "description": "Usps Shipping Service",
    "license": "MIT",
    "keywords": [
        "wordpress",
        "woocommerce",
        "usps"
    ],
    "homepage": "https:\/\/gitlab.com\/wpdesk\/predators\/library\/usps-shipping-service",
    "authors": [
        {
            "name": "grola",
            "email": "grola@wpdesk.net"
        }
    ],
    "require": {
        "php": ">=7.4",
        "psr\/log": "^1.1",
        "wpdesk\/wp-woocommerce-shipping": "^3.1.0",
        "guzzlehttp\/guzzle": "^7.12.1",
        "vinceg\/usps-php-api": "^1.1.0",
        "octolize\/usps-rest-api-client": "^1.0.0"
    },
    "require-dev": {
        "phpunit\/phpunit": "^7||^8||^9",
        "wp-coding-standards\/wpcs": "^3.4.1",
        "squizlabs\/php_codesniffer": "^3.0.2",
        "mockery\/mockery": "*",
        "10up\/wp_mock": "*",
        "phpcompatibility\/php-compatibility": "^9.1",
        "dealerdirect\/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "FlexibleShippingUspsVendor\\WPDesk\\UspsShippingService\\": "src\/UspsShippingService"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests\/unit"
        ]
    },
    "extra": {
        "text-domain": "usps-shipping-service",
        "translations-folder": "lang",
        "po-files": {
            "pl_PL": "pl_PL.po",
            "de_DE": "de_DE.po"
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpunit-unit": "phpunit --configuration phpunit-unit.xml --coverage-text --colors=never",
        "phpunit-unit-fast": "phpunit --configuration phpunit-unit.xml --no-coverage",
        "phpunit-integration": "phpunit --configuration phpunit-integration.xml --coverage-text --colors=never",
        "phpunit-integration-fast": "phpunit --configuration phpunit-integration.xml --no-coverage"
    },
    "config": {
        "gitlab-domains": [
            "gitlab.octolize.dev"
        ],
        "allow-plugins": {
            "dealerdirect\/phpcodesniffer-composer-installer": true
        }
    },
    "repositories": {
        "octolize": {
            "type": "composer",
            "url": "https:\/\/gitlab.octolize.dev\/api\/v4\/group\/wpdesk\/-\/packages\/composer\/"
        },
        "wpdesk": {
            "type": "composer",
            "url": "https:\/\/gitlab.octolize.dev\/api\/v4\/group\/wpdesk\/-\/packages\/composer\/"
        }
    }
}