{
    "name": "wpdesk\/wp-settings-field-boxes",
    "description": "Library for displaying box settings field in WooCommerce.",
    "license": "MIT",
    "keywords": [
        "woocommerce",
        "boxes"
    ],
    "homepage": "https:\/\/gitlab.octolize.dev\/wpdesk\/predators\/library\/wp-settings-field-boxes",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "grola",
            "email": "grola@wpdesk.net"
        }
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect\/phpcodesniffer-composer-installer": false
        },
        "gitlab-domains": [
            "gitlab.octolize.dev"
        ],
        "platform": {
            "php": "7.4"
        },
        "sort-packages": true
    },
    "repositories": {
        "wpdesk": {
            "type": "composer",
            "url": "https:\/\/gitlab.octolize.dev\/api\/v4\/group\/wpdesk\/-\/packages\/composer\/"
        }
    },
    "require": {
        "php": ">=7.4",
        "wpdesk\/wpdesk-packer": "^2|^3"
    },
    "require-dev": {
        "10up\/wp_mock": "*",
        "mockery\/mockery": "*",
        "phpunit\/phpunit": "^7||^8||^9",
        "wp-coding-standards\/wpcs": "^3.4.1",
        "squizlabs\/php_codesniffer": "^3.0.2",
        "wimg\/php-compatibility": "^8"
    },
    "autoload": {
        "psr-4": {
            "FlexibleShippingUspsVendor\\WpDesk\\WooCommerce\\ShippingMethod\\": "src\/"
        }
    },
    "autoload-dev": {},
    "extra": {
        "text-domain": "wp-settings-field-boxes",
        "translations-folder": "lang",
        "po-files": {
            "pl_PL": "pl_PL.po",
            "de_DE": "de_DE.po"
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpunit-unit": "phpunit --configuration phpunit-unit.xml --coverage-text --colors=never",
        "phpunit-unit-fast": "phpunit --configuration phpunit-unit.xml --no-coverage",
        "phpunit-integration": "phpunit --configuration phpunit-integration.xml --coverage-text --colors=never",
        "phpunit-integration-fast": "phpunit --configuration phpunit-integration.xml --no-coverage"
    }
}